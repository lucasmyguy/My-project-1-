:root {
}

.button {
    width: 20%;
    translate: -50% 0%;
    left: 50%;
    margin-top: 2%;
    margin-right: 0%;
    margin-bottom: 2%;
    margin-left: 0%;
    font-size: 52px;
    -unity-font-style: bold;
    border-top-width: 12px;
    border-right-width: 12px;
    border-bottom-width: 12px;
    border-left-width: 12px;
    border-left-color: rgb(96, 96, 96);
    border-right-color: rgb(96, 96, 96);
    border-top-color: rgb(96, 96, 96);
    border-bottom-color: rgb(96, 96, 96);
}

.button:hover {
    width: 20%;
    translate: -50% 0%;
    left: 50%;
    margin-top: 2%;
    margin-right: 0%;
    margin-bottom: 2%;
    margin-left: 0%;
    font-size: 52px;
    -unity-font-style: bold;
    border-top-width: 12px;
    border-right-width: 12px;
    border-bottom-width: 12px;
    border-left-width: 12px;
    border-left-color: rgb(96, 96, 96);
    border-right-color: rgb(96, 96, 96);
    border-top-color: rgb(96, 96, 96);
    border-bottom-color: rgb(96, 96, 96);
    scale: 1.1 1.1;
    rotate: 2deg;
}
